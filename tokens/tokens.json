{
	"$description": "NOVA design tokens (W3C Design Tokens format). Colors with a dark value carry it in $extensions[\"dev.novafile.modes\"].dark. Run `yarn tokens` after editing.",
	"color": {
		"ground": {
			"$type": "color",
			"$value": "#FAFAF7",
			"$description": "Page background",
			"$extensions": { "dev.novafile.modes": { "dark": "#0E0E14" } }
		},
		"surface": {
			"$type": "color",
			"$value": "#FFFFFF",
			"$description": "Cards, alternating sections",
			"$extensions": { "dev.novafile.modes": { "dark": "#15151D" } }
		},
		"sunken": {
			"$type": "color",
			"$value": "#F2F1EC",
			"$description": "Tab bars, table headers",
			"$extensions": { "dev.novafile.modes": { "dark": "#1B1B25" } }
		},
		"code": {
			"$type": "color",
			"$value": "#F4F3EE",
			"$description": "Code block background",
			"$extensions": { "dev.novafile.modes": { "dark": "#111119" } }
		},
		"line": {
			"$type": "color",
			"$value": "#E3E2DB",
			"$description": "Borders and rules",
			"$extensions": { "dev.novafile.modes": { "dark": "#2A2A37" } }
		},
		"ink": {
			"$type": "color",
			"$value": "#17171F",
			"$description": "Primary text",
			"$extensions": { "dev.novafile.modes": { "dark": "#ECECF2" } }
		},
		"muted": {
			"$type": "color",
			"$value": "#55566A",
			"$description": "Secondary text, at least 4.5:1 on ground",
			"$extensions": { "dev.novafile.modes": { "dark": "#A6A6B8" } }
		},
		"accent": {
			"$type": "color",
			"$value": "#4B3FD1",
			"$description": "Links, primary actions, the logo",
			"$extensions": { "dev.novafile.modes": { "dark": "#A39CFF" } }
		},
		"on-accent": {
			"$type": "color",
			"$value": "#FFFFFF",
			"$description": "Text on the accent color",
			"$extensions": { "dev.novafile.modes": { "dark": "#0E0E14" } }
		},
		"accent-soft": {
			"$type": "color",
			"$value": "#ECEAFD",
			"$description": "Accent tint for highlights",
			"$extensions": { "dev.novafile.modes": { "dark": "#25234A" } }
		},
		"warn": {
			"$type": "color",
			"$value": "#9A3412",
			"$description": "Problem annotations",
			"$extensions": { "dev.novafile.modes": { "dark": "#FDBA8C" } }
		},
		"warn-soft": {
			"$type": "color",
			"$value": "#FDEEE6",
			"$extensions": { "dev.novafile.modes": { "dark": "#3A2116" } }
		},
		"ok": {
			"$type": "color",
			"$value": "#1B6E4A",
			"$description": "Fix annotations, available status",
			"$extensions": { "dev.novafile.modes": { "dark": "#86D9AC" } }
		},
		"ok-soft": {
			"$type": "color",
			"$value": "#E3F2E9",
			"$extensions": { "dev.novafile.modes": { "dark": "#14301F" } }
		}
	},
	"syntax": {
		"fg": {
			"$type": "color",
			"$value": "#17171F",
			"$extensions": { "dev.novafile.modes": { "dark": "#ECECF2" } }
		},
		"key": {
			"$type": "color",
			"$value": "#3D35B0",
			"$description": "Record keys, table columns",
			"$extensions": { "dev.novafile.modes": { "dark": "#B3ADFF" } }
		},
		"string": {
			"$type": "color",
			"$value": "#1B6E4A",
			"$extensions": { "dev.novafile.modes": { "dark": "#86D9AC" } }
		},
		"number": {
			"$type": "color",
			"$value": "#A14A06",
			"$description": "Numbers, booleans, null",
			"$extensions": { "dev.novafile.modes": { "dark": "#F5AE6B" } }
		},
		"directive": {
			"$type": "color",
			"$value": "#86259F",
			"$description": "Directives, keywords, control lines",
			"$extensions": { "dev.novafile.modes": { "dark": "#DDA3F2" } }
		},
		"variant": {
			"$type": "color",
			"$value": "#0B6A80",
			"$description": "Variants, types, references",
			"$extensions": { "dev.novafile.modes": { "dark": "#72D2E3" } }
		},
		"comment": {
			"$type": "color",
			"$value": "#6B6B78",
			"$extensions": { "dev.novafile.modes": { "dark": "#8D8DA0" } }
		},
		"punctuation": {
			"$type": "color",
			"$value": "#55566A",
			"$extensions": { "dev.novafile.modes": { "dark": "#A6A6B8" } }
		},
		"operator": {
			"$type": "color",
			"$value": "#4B3FD1",
			"$description": "The patch arrow",
			"$extensions": { "dev.novafile.modes": { "dark": "#A39CFF" } }
		}
	},
	"font": {
		"sans": {
			"$type": "fontFamily",
			"$value": ["IBM Plex Sans", "system-ui", "-apple-system", "Segoe UI", "sans-serif"]
		},
		"mono": {
			"$type": "fontFamily",
			"$value": ["IBM Plex Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"]
		}
	},
	"font-size": {
		"display": { "$type": "dimension", "$value": "3.5rem" },
		"h1": { "$type": "dimension", "$value": "3rem" },
		"h2": { "$type": "dimension", "$value": "2rem" },
		"h3": { "$type": "dimension", "$value": "1.5rem" },
		"lead": { "$type": "dimension", "$value": "1.25rem" },
		"body": { "$type": "dimension", "$value": "1.0625rem" },
		"small": { "$type": "dimension", "$value": "0.9375rem" },
		"code": { "$type": "dimension", "$value": "0.90625rem" },
		"caption": { "$type": "dimension", "$value": "0.8125rem" }
	},
	"font-weight": {
		"regular": { "$type": "fontWeight", "$value": 400 },
		"medium": { "$type": "fontWeight", "$value": 500 },
		"semibold": { "$type": "fontWeight", "$value": 600 },
		"bold": { "$type": "fontWeight", "$value": 700 }
	},
	"line-height": {
		"tight": { "$type": "number", "$value": 1.08 },
		"heading": { "$type": "number", "$value": 1.2 },
		"body": { "$type": "number", "$value": 1.6 },
		"code": { "$type": "number", "$value": 1.7 }
	},
	"letter-spacing": {
		"display": { "$type": "dimension", "$value": "-0.03em" },
		"heading": { "$type": "dimension", "$value": "-0.02em" }
	},
	"space": {
		"1": { "$type": "dimension", "$value": "0.25rem" },
		"2": { "$type": "dimension", "$value": "0.5rem" },
		"3": { "$type": "dimension", "$value": "0.75rem" },
		"4": { "$type": "dimension", "$value": "1rem" },
		"5": { "$type": "dimension", "$value": "1.25rem" },
		"6": { "$type": "dimension", "$value": "1.5rem" },
		"8": { "$type": "dimension", "$value": "2rem" },
		"10": { "$type": "dimension", "$value": "2.5rem" },
		"12": { "$type": "dimension", "$value": "3rem" },
		"16": { "$type": "dimension", "$value": "4rem" },
		"20": { "$type": "dimension", "$value": "5rem" }
	},
	"radius": {
		"sm": { "$type": "dimension", "$value": "4px" },
		"md": { "$type": "dimension", "$value": "8px" },
		"lg": { "$type": "dimension", "$value": "10px" },
		"xl": { "$type": "dimension", "$value": "12px" },
		"pill": { "$type": "dimension", "$value": "999px" }
	},
	"size": {
		"content": {
			"$type": "dimension",
			"$value": "75rem",
			"$description": "Max width of page content"
		},
		"prose": {
			"$type": "dimension",
			"$value": "45rem",
			"$description": "Max width of running text, about 72 characters"
		},
		"touch": { "$type": "dimension", "$value": "44px", "$description": "Minimum touch target" },
		"control": { "$type": "dimension", "$value": "48px", "$description": "Button height" }
	}
}
