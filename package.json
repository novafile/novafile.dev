{
	"name": "novafile.dev",
	"private": true,
	"version": "0.0.0",
	"description": "The website for NOVA, the Notation for Objects, Values & Agents.",
	"type": "module",
	"packageManager": "yarn@4.18.1",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"tokens": "node scripts/build-tokens.mjs",
		"dev": "yarn tokens && vite dev",
		"build": "yarn tokens && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"storybook": "yarn tokens && storybook dev -p 6006",
		"build-storybook": "yarn tokens && storybook build -o storybook-static",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"@fontsource/ibm-plex-mono": "^5",
		"@fontsource/ibm-plex-sans": "^5",
		"@storybook/addon-a11y": "^10.6.6",
		"@storybook/addon-docs": "^10.6.6",
		"@storybook/sveltekit": "^10.6.6",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"prettier": "^3",
		"prettier-plugin-svelte": "^3",
		"shiki": "^4.6.0",
		"storybook": "^10.6.6",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
